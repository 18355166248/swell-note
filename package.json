{
  "name": "swell-note",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "build:android:debug": "tauri android build --debug --apk --target aarch64 --ci",
    "build:ios:device": "tauri ios build --debug --target aarch64 --export-method debugging",
    "build:ios:sim": "tauri ios build --debug --target aarch64-sim --no-sign --ci",
    "build:mac": "tauri build --bundles app,dmg",
    "build:mac:universal": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "dev:ios": "tauri ios dev --force-ip-prompt",
    "dev:ios:open": "tauri ios dev --open --host",
    "icons": "node scripts/generate-icons.mjs",
    "ios": "node scripts/ios-device-run.mjs --device Swell5",
    "ios:refresh-icons": "node scripts/ios-device-run.mjs --device Swell5 --refresh-icons",
    "ios:dev": "node scripts/ios-device-run.mjs --dev --device Swell5",
    "build": "tsc && vite build",
    "bench:notes": "vitest bench src/services/search/note-library.bench.ts",
    "bench:interaction": "node scripts/perf-bench.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:webdav:live": "VITE_WEBDAV_E2E_DIRECT=1 SWELL_WEBDAV_E2E_CONFIRM=write-dedicated-test-file vitest run src/services/webdav-live.integration.test.ts",
    "preview": "vite preview",
    "check:ios:device": "node scripts/ios-device-check.mjs",
    "release:check": "node scripts/release-readiness.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "8.0.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.33.0",
    "lz-string": "1.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
