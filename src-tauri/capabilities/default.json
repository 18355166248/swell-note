{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://dav.jianguoyun.com/**" }]
    },
    "opener:default",
    "process:allow-restart",
    "updater:default"
  ]
}
